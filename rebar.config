{erl_opts, [debug_info]}.
{deps, [
	{pe4kin, "0.2.5" },
        {hackney, "3.0.1"}
]}.

{shell, [
    {config, "config/sys.config"},
    {apps, [gun, pe4kin, inky]}
]}.

{relx, [
    {release, {inky, "0.1.0"}, [inky, gun, pe4kin, jsx, hackney, sasl]},
    {sys_config, "config/sys.config"},
    {dev_mode, true},
    {include_erts, false},
    {extended_start_script, true}
]}.

{profiles, [
    {prod, [
        {relx, [
            {dev_mode, false},
            {include_erts, true}
        ]}
    ]}
]}.
